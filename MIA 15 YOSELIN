/* =========================
   DESTELLOS
========================= */

.spark{
  position:fixed;
  width:3px;
  height:3px;
  border-radius:50%;
  background:#fff;
  box-shadow:
    0 0 7px #fff,
    0 0 15px #ff4f91;
  pointer-events:none;
  z-index:-1;
  animation:floatSpark linear infinite;
}

@keyframes floatSpark{
  0%{
    transform:translateY(110vh) scale(.3);
    opacity:0;
  }
  15%{opacity:1;}
  85%{opacity:1;}
  100%{
    transform:translateY(-10vh) scale(1);
    opacity:0;
  }
}

/* =========================
   RESPONSIVE
========================= */

@media(max-width:700px){

  .glass{
