<script>

/* =========================
   ABRIR INVITACIÓN
========================= */

const openButton = document.getElementById("openInvitation");
const welcome = document.getElementById("welcome");
const invitation = document.getElementById("invitation");
const music = document.getElementById("music");

openButton.addEventListener("click", function(){

  /* Intentar reproducir música */
  music.play().catch(function(){
    /* Algunos navegadores pueden bloquear el audio.
       El usuario podrá iniciarlo desde el reproductor. */
  });

  /* Fuegos */
  startFireworks();

  /* Transición */
  setTimeout(function(){
    welcome.classList.add("hidden");
    invitation.classList.add("visible");
    document.body.style.overflow = "auto";
  }, 900);

});


/* =========================
   CUENTA REGRESIVA
========================= */

const eventDate = new Date("2026-12-05T20:00:00-03:00").getTime();

function updateCountdown(){

  const now = Date.now();
  let distance = eventDate - now;

  if(distance < 0){
    distance = 0;
  }

  const days = Math.floor(distance / (1000 * 60 * 60 * 24));

  const hours = Math.floor(
    (distance % (1000 * 60 * 60 * 24)) /
    (1000 * 60 * 60)
  );

  const minutes = Math.floor(
    (distance % (1000 * 60 * 60)) /
    (1000 * 60)
  );

  const seconds = Math.floor(
    (distance % (1000 * 60)) /
    1000
  );

  document.getElementById("days").textContent =
    String(days).padStart(2,"0");

  document.getElementById("hours").textContent =
    String(hours).padStart(2,"0");

  document.getElementById("minutes").textContent =
    String(minutes).padStart(2,"0");

  document.getElementById("seconds").textContent =
    String(seconds).padStart(2,"0");
}

updateCountdown();
setInterval(updateCountdown,1000);


/* =========================
   PARTÍCULAS
========================= */

const particleContainer =
  document.getElementById("particles");

for(let i = 0; i < 55; i++){

  const spark = document.createElement("div");

  spark.className = "spark";

  spark.style.left =
    Math.random() * 100 + "%";

  spark.style.animationDuration =
    (5 + Math.random() * 9) + "s";

  spark.style.animationDelay =
    (-Math.random() * 10) + "s";

  spark.style.opacity =
    .3 + Math.random() * .7;

  const size =
    1 + Math.random() * 4;

  spark.style.width = size + "px";
  spark.style.height = size + "px";

  particleContainer.appendChild(spark);
}


/* =========================
   FUEGOS ARTIFICIALES
========================= */

const canvas = document.getElementById("fireworks");
const ctx = canvas.getContext("2d");

let fireworks = [];
let fireworkParticles = [];
let fireworksRunning = false;

const fireColors = [
  "#ffffff",
  "#dddddd",
  "#ff304f",
  "#ff4f91",
  "#cfcfd8"
];

function resizeCanvas(){

  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;

}

resizeCanvas();

window.addEventListener("resize", resizeCanvas);


/* Crear cohete */

function createFirework(){

  const startX =
    Math.random() * canvas.width;

  const targetX =
    canvas.width * (.15 + Math.random() * .7);

  const targetY =
    canvas.height * (.12 + Math.random() * .42);

  fireworks.push({
    x:startX,
    y:canvas.height + 10,
    targetX:targetX,
    targetY:targetY,
    speed:8 + Math.random() * 4,
    color:fireColors[
      Math.floor(Math.random() * fireColors.length)
    ]
  });

}


/* Explosión */

function explode(x,y,color){

  const amount = 90 + Math.floor(Math.random() * 45);

  for(let i=0;i<amount;i++){

    const angle =
      Math.random() * Math.PI * 2;

    const speed =
      1.5 + Math.random() * 6;

    fireworkParticles.push({

      x:x,
      y:y,

      vx:Math.cos(angle) * speed,
      vy:Math.sin(angle) * speed,

      life:1,

      decay:.008 + Math.random() * .014,

      color:color

    });

  }

}


/* Animación */

function animateFireworks(){

  if(!fireworksRunning) return;

  ctx.clearRect(
    0,
    0,
    canvas.width,
    canvas.height
  );

  /* Cohetes */

  for(let i=fireworks.length-1;i>=0;i--){

    const f = fireworks[i];

    const dx = f.targetX - f.x;
    const dy = f.targetY - f.y;

    const distance =
      Math.sqrt(dx*dx + dy*dy);

    const vx =
      dx / distance * f.speed;

    const vy =
      dy / distance * f.speed;

    f.x += vx;
    f.y += vy;

    ctx.beginPath();
    ctx.arc(f.x,f.y,2,0,Math.PI*2);

    ctx.fillStyle=f.color;
    ctx.shadowBlur=15;
    ctx.shadowColor=f.color;
    ctx.fill();

    if(distance < 15){

      explode(
        f.x,
        f.y,
        f.color
      );

      fireworks.splice(i,1);

    }

  }


  /* Partículas */

  for(let i=fireworkParticles.length-1;i>=0;i--){

    const p=fireworkParticles[i];

    p.x += p.vx;
    p.y += p.vy;

    p.vy += .045;

    p.vx *= .985;
    p.vy *= .985;

    p.life -= p.decay;

    if(p.life<=0){

      fireworkParticles.splice(i,1);
      continue;

    }

    ctx.beginPath();

    ctx.arc(
      p.x,
      p.y,
      1.5 + p.life * 2,
      0,
      Math.PI*2
    );

    ctx.globalAlpha=p.life;

    ctx.fillStyle=p.color;

    ctx.shadowBlur=18;
    ctx.shadowColor=p.color;

    ctx.fill();

  }

  ctx.globalAlpha=1;

  requestAnimationFrame(animateFireworks);

}


/* Lanzamiento automático */

function startFireworks(){

  canvas.classList.add("active");

  fireworksRunning=true;

  for(let i=0;i<4;i++){

    setTimeout(
      createFirework,
      i * 250
    );

  }

  animateFireworks();

  const launchInterval =
    setInterval(function(){

      if(!fireworksRunning){

        clearInterval(launchInterval);
        return;

      }

      createFirework();

    },700);


  /* Los fuegos duran unos segundos */

  setTimeout(function(){

    fireworksRunning=false;

    canvas.classList.remove("active");

    ctx.clearRect(
      0,
      0,
      canvas.width,
      canvas.height
    );

  },9000);

}

</script>

