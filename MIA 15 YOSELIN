}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:Georgia, "Times New Roman", serif;
  background:
    radial-gradient(circle at 50% 10%, rgba(255,255,255,.13), transparent 25%),
    radial-gradient(circle at 20% 50%, rgba(255,0,70,.18), transparent 30%),
    linear-gradient(135deg,#180004,#650014 45%,#210006 100%);
  color:white;
  overflow-x:hidden;
}

/* =========================
   FONDO Y LUCES
========================= */

body::before{
  content:"";
  position:fixed;
  inset:-30%;
  z-index:-5;
  background:
    conic-gradient(
      from 0deg,
      transparent 0deg,
      rgba(255,255,255,.08) 8deg,
      transparent 18deg,
      transparent 55deg,
      rgba(255,0,80,.10) 65deg,
      transparent 80deg
    );
  animation:lightsRotate 18s linear infinite;
  pointer-events:none;
}

@keyframes lightsRotate{
  to{transform:rotate(360deg);}
}

.disco-light{
  position:fixed;
  width:35vw;
  height:80vh;
  top:-20vh;
  z-index:-3;
  filter:blur(15px);
  opacity:.18;
  transform-origin:top center;
  pointer-events:none;
}

.light-left{
  left:0;
  background:linear-gradient(to bottom,rgba(255,40,90,.9),transparent);
  transform:rotate(-25deg);
  animation:sweepLeft 7s ease-in-out infinite alternate;
}

.light-right{
  right:0;
  background:linear-gradient(to bottom,rgba(255,255,255,.8),transparent);
  transform:rotate(25deg);
  animation:sweepRight 8s ease-in-out infinite alternate;
}

@keyframes sweepLeft{
  to{transform:rotate(25deg);}
}

@keyframes sweepRight{
  to{transform:rotate(-25deg);}
}

#particles{
  position:fixed;
  inset:0;
  pointer-events:none;
  z-index:-1;
}

/* =========================
   BIENVENIDA
========================= */

#welcome{
  position:fixed;
  inset:0;
  z-index:1000;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  overflow:hidden;
  background:
    radial-gradient(circle at center,rgba(170,0,35,.35),transparent 35%),
    linear-gradient(135deg,#160004,#720019,#170004);
  transition:opacity 1.2s ease, visibility 1.2s ease;
}

#welcome.hidden{
  opacity:0;
  visibility:hidden;
  pointer-events:none;
}

.welcome-content{
  width:min(92%,700px);
  padding:30px 20px;
  position:relative;
  z-index:2;
}

.welcome-small{
  letter-spacing:7px;
  font-size:clamp(.7rem,2vw,1rem);
  color:#ddd;
  margin-bottom:12px;
  text-transform:uppercase;
}

.welcome-name{
  font-size:clamp(4rem,15vw,9rem);
  line-height:.9;
  font-weight:400;
  font-style:italic;
  background:linear-gradient(
    100deg,
    #777,
    #fff,
    #aaa,
    #fff,
    #777
  );
  background-size:300%;
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
  animation:metal 5s linear infinite;
  text-shadow:0 0 25px rgba(255,255,255,.15);
}

@keyframes metal{
  to{background-position:300% center;}
}

.welcome-event{
  margin-top:15px;
  letter-spacing:10px;
  font-size:clamp(1.1rem,4vw,2rem);
  color:#fff;
  text-shadow:0 0 18px rgba(255,50,100,.8);
}

.open-button{
  margin-top:40px;
  border:1px solid rgba(255,255,255,.65);
  background:linear-gradient(135deg,rgba(255,255,255,.18),rgba(255,0,70,.25));
  color:white;
  padding:18px 38px;
  border-radius:50px;
  font-family:inherit;
  font-size:1rem;
  letter-spacing:3px;
  cursor:pointer;
  box-shadow:
    0 0 25px rgba(255,30,90,.4),
    inset 0 0 20px rgba(255,255,255,.08);
  backdrop-filter:blur(12px);
  transition:.35s ease;
}

.open-button:hover{
  transform:scale(1.06);
  box-shadow:
    0 0 45px rgba(255,50,110,.8),
    inset 0 0 25px rgba(255,255,255,.15);
}

/* =========================
   BOLA DE ESPEJOS
========================= */

.disco-ball{
  width:min(55vw,300px);
  aspect-ratio:1;
  border-radius:50%;
  position:relative;
  margin:0 auto 30px;
  background:
    repeating-linear-gradient(
      0deg,
      transparent 0 17px,
      rgba(0,0,0,.35) 18px 20px
    ),
    repeating-linear-gradient(
      90deg,
      transparent 0 17px,
      rgba(0,0,0,.35) 18px 20px
    ),
    linear-gradient(135deg,#555,#fff,#777,#eee,#444);
  box-shadow:
    0 0 20px rgba(255,255,255,.8),
    0 0 60px rgba(255,0,80,.35);
  animation:ballSpin 10s linear infinite;
  overflow:hidden;
}

.disco-ball::before{
  content:"";
  position:absolute;
  inset:0;
  border-radius:50%;
  background:
    radial-gradient(circle at 30% 25%,white 0 3%,transparent 4%),
    radial-gradient(circle at 65% 35%,white 0 2%,transparent 3%),
    radial-gradient(circle at 40% 70%,white 0 3%,transparent 4%),
    radial-gradient(circle at 80% 70%,white 0 2%,transparent 3%);
  background-size:45px 45px;
  mix-blend-mode:screen;
}

.disco-ball::after{
  content:"";
  position:absolute;
  inset:0;
  border-radius:50%;
  background:radial-gradient(circle at 35% 25%,rgba(255,255,255,.85),transparent 15%,rgba(0,0,0,.35) 80%);
}

@keyframes ballSpin{
  to{transform:rotate(360deg);}
}

/* =========================
   CONTENIDO
========================= */

main{
